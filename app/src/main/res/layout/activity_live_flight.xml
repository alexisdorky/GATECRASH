<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/backFromLiveFlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← BACK"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_dark"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LIVE FLIGHT RADAR"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Live Flight Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/primary_dark"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/liveFlightNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✈️ AI 302"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/liveFlightStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 IN FLIGHT"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="#2E7D32"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/liveAirlineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Air India"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/liveRouteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEL (Delhi)  ➔  BOM (Mumbai)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Flight Route Progress -->
                <ProgressBar
                    android:id="@+id/flightProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="65"
                    android:progressTint="@color/accent"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/routeStartCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Departed"
                        android:textColor="#CFD8DC"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/routeEndCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="En Route • Cruising"
                        android:textColor="#CFD8DC"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Telemetry Row (Altitude & Speed) -->
                <LinearLayout
                    android:id="@+id/liveTelemetryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1B3358"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/liveAltitudeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Alt: 11,887 m"
                        android:textColor="#81D4FA"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/liveSpeedText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💨 Speed: 872 km/h"
                        android:textColor="#81D4FA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#30FFFFFF"
                    android:layout_marginBottom="16dp" />

                <!-- Timing Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Departure Time:"
                        android:textColor="#ECEFF1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/liveSchedDepText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="14:00"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimated Arrival:"
                        android:textColor="#ECEFF1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/liveEstArrText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="16:15"
                        android:textColor="#81C784"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/liveTerminalGateText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Terminal 2  •  Gate B24"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/liveBaggageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧳 Belt 2"
                        android:textColor="#FFE082"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Google Places Verified Badge -->
                <TextView
                    android:id="@+id/livePlacesBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Google Places: Chhatrapati Shivaji Maharaj International Airport (BOM)"
                    android:textColor="#80D8FF"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Refresh Live Radar Button -->
        <Button
            android:id="@+id/refreshRadarBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 REFRESH LIVE RADAR"
            android:backgroundTint="@color/primary_light"
            android:textColor="@color/primary_dark"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Quick Map Action for this flight's gate -->
        <Button
            android:id="@+id/locateGateOnMapBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🗺️ LOCATE TERMINAL &amp; GATE ON MAP"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/flightApiNoticeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Real-time flight telemetry powered by AviationStack Live Radar &amp; Google Places API."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
